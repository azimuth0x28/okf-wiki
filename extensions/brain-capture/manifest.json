{
  "manifest_version": 3,
  "name": "Brain Capture",
  "description": "Capture web pages into your okf-wiki bundle's _raw/ inbox.",
  "version": "0.1.0",
  "action": {
    "default_title": "Brain Capture",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "nativeMessaging",
    "storage"
  ]
}
